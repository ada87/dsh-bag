{
  "name": "dsh-bag",
  "version": "0.4.0",
  "description": "Portable capability packs for DeepSeek Harness: import Claude Code skills and sync settings, presets, hooks and profiles through a folder, Git, or an encrypted .dshbag.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "skills",
    "sync",
    "config",
    "settings",
    "profiles",
    "capability-pack",
    "claude-code"
  ],
  "license": "MIT",
  "author": "ada87",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ada87/dsh-bag.git"
  },
  "homepage": "https://github.com/ada87/dsh-bag#readme",
  "bugs": {
    "url": "https://github.com/ada87/dsh-bag/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0",
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node build.mjs && node --check client/client.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
